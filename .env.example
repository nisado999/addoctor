# URL of your deployed Cloudflare Worker (api/worker.js), no trailing slash.
VITE_ADDOCTOR_API=
# Optional shared key, must match APP_KEY in the Worker. Visible in the built site, so it only stops casual abuse.
VITE_ADDOCTOR_KEY=
# Meta Ads Plan "work with me" box. All optional: name and email default to Nisado; a booking link (https://...,
# e.g. Calendly) adds a "Book a call" button.
VITE_AGENCY_NAME=
VITE_AGENCY_EMAIL=
VITE_AGENCY_BOOKING=
